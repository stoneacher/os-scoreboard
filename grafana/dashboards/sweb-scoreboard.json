          "query": "  from(bucket: \"${bucket}\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._measurement == \"team_scoreboard\")\n    |> filter(fn: (r) => exists r.team_id and r.team_id =~ /^${team_id:regex}$/)\n    |> filter(fn: (r) => r._field == \"rank\" or r._field == \"score\" or r._field == \"threads\" or r._field == \"fork_exec\" or r._field == \"other\" or r._field == \"avg_5d\" or r._field == \"up_count\" or\n  r._field == \"tw\" or r._field == \"perf\" or r._field == \"build_ok\" or r._field == \"boot_ok\")\n    |> group(columns: [\"team_id\", \"display_name\", \"_field\", \"submission1\"])\n    |> last()\n    |> pivot(rowKey: [\"team_id\", \"display_name\", \"submission1\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n    |> group()\n    |> keep(columns: [\"rank\", \"team_id\", \"display_name\", \"score\", \"threads\", \"fork_exec\", \"other\", \"avg_5d\", \"up_count\", \"tw\", \"perf\", \"build_ok\", \"boot_ok\", \"submission1\"])\n    |> sort(columns: [\"rank\"])",
